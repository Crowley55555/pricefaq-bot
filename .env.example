# ─── Telegram ────────────────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID менеджера, которому летят заявки (можно узнать у @userinfobot)
MANAGER_CHAT_ID=

# ─── LLM-провайдеры (нужен хотя бы один) ────────────────────────────────
# GigaChat (Сбер)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# или по client_id/client_secret:
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=

# Yandex GPT
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
# или через IAM-токен сервисного аккаунта:
# YANDEX_KEY_ID=
# YANDEX_SERVICE_ACCOUNT_ID=
# YANDEX_PRIVATE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── ChromaDB ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=pricefaq_knowledge

# ─── API ─────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ─── Логи ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
